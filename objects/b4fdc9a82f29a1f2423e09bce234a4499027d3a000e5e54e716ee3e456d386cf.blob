-02-05"}],"excludedObservations":2309,"firstObservation":"2022-09-15","historicalVintagesVerified":false,"independentMarketCycles":null,"informationThrough":"2026-11-03","initialVariance":0.001205058582001604,"innovationCount":597,"innovationPopulationMean":-5.114092659496115e-18,"innovationPopulationSecondMoment":0.9999999999999994,"maxSourceDate":"2026-11-03","missingDaysInterpolated":false,"observations":1511,"pricePredictionAccuracyProven":false,"states":{"down":{"completedDurations":[51,68],"eventsByAge":[0,2,0,0,0,0],"hazard":[0.006218905472636816,0.014613126834447012,0.008291873963515755,0.008291873963515755,0.008291873963515755,0.008291873963515755],"longRunVariance":0.0012762745378081133,"mean":0.00028771091086771073,"pooledHazard":0.008291873963515755,"rawMean":0.0011701855534451428,"returnCount":119,"riskByAge":[60,59,0,0,0,0],"riskDays":119,"switches":2},"up":{"completedDurations":[281],"eventsByAge":[0,0,0,1,0,0],"hazard":[0.0017032551097653293,0.0013626040878122634,0.0011355034065102195,0.004727453779676775,0.002271006813020439,0.002271006813020439],"longRunVariance":0.0011786115142237653,"mean":0.000055003184237364875,"pooledHazard":0.002271006813020439,"rawMean":0.00009700352366547821,"returnCount":478,"riskByAge":[60,120,180,118,0,0],"riskDays":478,"switches":1}},"unclassifiedReturns":913},"warnings":["ETH에서 확인된 상태의 기간과 변동성을 추정합니다. 3년 상승·1년 하락이나 고저점 날짜를 고정하지 않습니다.","음영은 가정한 모형의 10–90% 모의 분위수입니다. 실제 80% 적중률·신뢰구간·전 경로 보장은 아닙니다.","금색 경로는 동일 모형의 예시 1개이며 파란 중앙값도 실제로 실현되는 한 경로는 아닐 수 있습니다.","소수의 Merge 이후 상태와 현재 판본으로 적합했습니다. 계수 불확실성·새로운 위기·프로토콜 변화는 모두 반영되지 않습니다.","AI 채택·기관 목표가격을 가격 상승률로 자동 변환하지 않습니다. 미래 OHLC와 거래량은 만들지 않습니다."]},"outputHash":"1a3c4624ed6ff19242bb8371f215965735e1612236ad0b56ddd751fb3cb4daf8","productionAdopted":false,"prospectiveAccuracyProven":false,"publicationScope":"draft-pr-research","recordKind":"issued","recordPolicy":"eth-prospective-record-1","runKey":"93be4c9a992071ad14b19730625d139716d0a642d23100d7fe66b128fc563e82","schemaVersion":1
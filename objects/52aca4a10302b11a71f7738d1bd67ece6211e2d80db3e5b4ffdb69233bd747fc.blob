ied":false,"independentMarketCycles":null,"informationThrough":"2026-10-30","initialVariance":0.0012127146602439718,"innovationCount":593,"innovationPopulationMean":4.0276008123522225e-17,"innovationPopulationSecondMoment":1.000000000000001,"maxSourceDate":"2026-10-30","missingDaysInterpolated":false,"observations":1507,"pricePredictionAccuracyProven":false,"states":{"down":{"completedDurations":[51,68],"eventsByAge":[0,2,0,0,0,0],"hazard":[0.006218905472636816,0.014613126834447012,0.008291873963515755,0.008291873963515755,0.008291873963515755,0.008291873963515755],"longRunVariance":0.0012801185938293856,"mean":0.00028771091086771073,"pooledHazard":0.008291873963515755,"rawMean":0.0011701855534451428,"returnCount":119,"riskByAge":[60,59,0,0,0,0],"riskDays":119,"switches":2},"up":{"completedDurations":[281],"eventsByAge":[0,0,0,1,0,0],"hazard":[0.0017136329017517138,0.0013709063214013709,0.0011424219345011425,0.004800244545647658,0.002284843869002285,0.002284843869002285],"longRunVariance":0.0011876166868421874,"mean":0.00003911689761423768,"pooledHazard":0.002284843869002285,"rawMean":0.00006923855927920974,"returnCount":474,"riskByAge":[60,120,180,114,0,0],"riskDays":474,"switches":1}},"unclassifiedReturns":913},"warnings":["ETH에서 확인된 상태의 기간과 변동성을 추정합니다. 3년 상승·1년 하락이나 고저점 날짜를 고정하지 않습니다.","음영은 가정한 모형의 10–90% 모의 분위수입니다. 실제 80% 적중률·신뢰구간·전 경로 보장은 아닙니다.","금색 경로는 동일 모형의 예시 1개이며 파란 중앙값도 실제로 실현되는 한 경로는 아닐 수 있습니다.","소수의 Merge 이후 상태와 현재 판본으로 적합했습니다. 계수 불확실성·새로운 위기·프로토콜 변화는 모두 반영되지 않습니다.","AI 채택·기관 목표가격을 가격 상승률로 자동 변환하지 않습니다. 미래 OHLC와 거래량은 만들지 않습니다."]},"outputHash":"6ffd21ce51b5f6df045b5f7d54c7730cbb25ef948675cbb7efa854669f681532","productionAdopted":false,"prospectiveAccuracyProven":false,"publicationScope":"draft-pr-research","recordKind":"issued","recordPolicy":"eth-prospective-record-1","runKey":"a017f2f2de8edb876144f81cfdeda868b3630a1d150d7fb14be6853fdef1e9cf","schemaVersion":1,"snapshotId":"11c89367f3e399352fa4b1fe2ce3961c2a6033472b627cdc6ca236ffdd0118e3","symbol":"ETHU
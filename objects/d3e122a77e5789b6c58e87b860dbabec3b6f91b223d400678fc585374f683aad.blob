istoricalVintagesVerified":false,"independentMarketCycles":null,"informationThrough":"2026-11-04","initialVariance":0.001209866493070591,"innovationCount":598,"innovationPopulationMean":4.0101701223918696e-17,"innovationPopulationSecondMoment":1.0000000000000022,"maxSourceDate":"2026-11-04","missingDaysInterpolated":false,"observations":1512,"pricePredictionAccuracyProven":false,"states":{"down":{"completedDurations":[51,68],"eventsByAge":[0,2,0,0,0,0],"hazard":[0.006218905472636816,0.014613126834447012,0.008291873963515755,0.008291873963515755,0.008291873963515755,0.008291873963515755],"longRunVariance":0.0012786885517339646,"mean":0.00028771091086771073,"pooledHazard":0.008291873963515755,"rawMean":0.0011701855534451428,"returnCount":119,"riskByAge":[60,59,0,0,0,0],"riskDays":119,"switches":2},"up":{"completedDurations":[281],"eventsByAge":[0,0,0,1,0,0],"hazard":[0.0017006802721088435,0.001360544217687075,0.0011337868480725624,0.004709576138147566,0.0022675736961451248,0.0022675736961451248],"longRunVariance":0.0011844637261742646,"mean":0.000131008013918239,"pooledHazard":0.0022675736961451248,"rawMean":0.00023083666753025825,"returnCount":479,"riskByAge":[60,120,180,119,0,0],"riskDays":479,"switches":1}},"unclassifiedReturns":913},"warnings":["ETH에서 확인된 상태의 기간과 변동성을 추정합니다. 3년 상승·1년 하락이나 고저점 날짜를 고정하지 않습니다.","음영은 가정한 모형의 10–90% 모의 분위수입니다. 실제 80% 적중률·신뢰구간·전 경로 보장은 아닙니다.","금색 경로는 동일 모형의 예시 1개이며 파란 중앙값도 실제로 실현되는 한 경로는 아닐 수 있습니다.","소수의 Merge 이후 상태와 현재 판본으로 적합했습니다. 계수 불확실성·새로운 위기·프로토콜 변화는 모두 반영되지 않습니다.","AI 채택·기관 목표가격을 가격 상승률로 자동 변환하지 않습니다. 미래 OHLC와 거래량은 만들지 않습니다."]},"outputHash":"3cf80519cae326e5fec1640952bf1354918fdf98446f60eba7aac83d6ce6efd6","productionAdopted":false,"prospectiveAccuracyProven":false,"publicationScope":"draft-pr-research","recordKind":"issued","recordPolicy":"eth-prospective-record-1","runKey":"eab71cbf6e321b7509f0acbe65ff2f724e381f290fbc50ee9bc811248d4f7109","schemaVersion":1,"snapshotId":"70e43b8f9e7044cc98825325885c2ca8c00e5ca6219532466ef32a02d7
"},{"knownAt":"2026-04-20","price":1823.2,"state":"up","turnDate":"2026-02-05"}],"excludedObservations":2309,"firstObservation":"2022-09-15","historicalVintagesVerified":false,"independentMarketCycles":null,"informationThrough":"2026-11-06","initialVariance":0.0012167770168216732,"innovationCount":600,"innovationPopulationMean":-7.207776042683634e-18,"innovationPopulationSecondMoment":0.9999999999999998,"maxSourceDate":"2026-11-06","missingDaysInterpolated":false,"observations":1514,"pricePredictionAccuracyProven":false,"states":{"down":{"completedDurations":[51,68],"eventsByAge":[0,2,0,0,0,0],"hazard":[0.006218905472636816,0.014613126834447012,0.008291873963515755,0.008291873963515755,0.008291873963515755,0.008291873963515755],"longRunVariance":0.0012821582707721647,"mean":0.00028771091086771073,"pooledHazard":0.008291873963515755,"rawMean":0.0011701855534451428,"returnCount":119,"riskByAge":[60,59,0,0,0,0],"riskDays":119,"switches":2},"up":{"completedDurations":[281],"eventsByAge":[0,0,0,1,0,0],"hazard":[0.0016955538809344387,0.001356443104747551,0.0011303692539562924,0.004674195785462676,0.002260738507912585,0.002260738507912585],"longRunVariance":0.0011927753883194218,"mean":0.000035782989567907743,"pooledHazard":0.002260738507912585,"rawMean":0.00006293640161008306,"returnCount":481,"riskByAge":[60,120,180,121,0,0],"riskDays":481,"switches":1}},"unclassifiedReturns":913},"warnings":["ETH에서 확인된 상태의 기간과 변동성을 추정합니다. 3년 상승·1년 하락이나 고저점 날짜를 고정하지 않습니다.","음영은 가정한 모형의 10–90% 모의 분위수입니다. 실제 80% 적중률·신뢰구간·전 경로 보장은 아닙니다.","금색 경로는 동일 모형의 예시 1개이며 파란 중앙값도 실제로 실현되는 한 경로는 아닐 수 있습니다.","소수의 Merge 이후 상태와 현재 판본으로 적합했습니다. 계수 불확실성·새로운 위기·프로토콜 변화는 모두 반영되지 않습니다.","AI 채택·기관 목표가격을 가격 상승률로 자동 변환하지 않습니다. 미래 OHLC와 거래량은 만들지 않습니다."]},"outputHash":"695bc649d5cc42f97fec7e7aa55614cd40f3d5fede584854ebeafe5019f20b8c","productionAdopted":false,"prospectiveAccuracyProven":false,"publicationScope":"draft-pr-research","recordKind":"issued","recordPolicy":"eth-prospective-record-1","runKey":"4e9b7dfea054
{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "allowJs": true,
    "checkJs": false,
    "skipLibCheck": true,
    "types": [
      "node"
    ],
    "esModuleInterop": true
  },
  "include": [
    "apps/**/*.ts",
    "apps/**/*.tsx",
    "packages/contracts/**/*.ts",
    "tests/service/**/*.ts",
    "tests/web/**/*.tsx"
  ]
}

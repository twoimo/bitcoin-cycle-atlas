{
  "name": "bitcoin-cycle-atlas",
  "version": "1.36.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "node scripts/test.mjs",
    "verify:treasury-paths": "node scripts/verify-treasury-paths.mjs",
    "verify:numerics": "node scripts/verify-system-numerics.mjs && node scripts/verify-system-independent-review.mjs && node scripts/verify-cycle-decision.mjs && node scripts/verify-cycle-table-integration.mjs && node scripts/refresh-asset-comparison.mjs --check && node scripts/verify-asset-comparison.mjs",
    "verify:asset-comparison": "node scripts/refresh-asset-comparison.mjs --check && node scripts/verify-asset-comparison.mjs",
    "verify:cycle-table": "node scripts/verify-cycle-decision.mjs && node scripts/verify-cycle-table-integration.mjs",
    "verify:static": "node scripts/verify-static.mjs",
    "verify:conference": "node scripts/verify-conference-timeline.mjs",
    "verify:conference:browser": "node scripts/verify-conference-browser.mjs",
    "verify:conference:media": "node scripts/verify-conference-media-browser.mjs",
    "refresh:cycle": "node scripts/refresh-cycle-calibration.mjs",
    "refresh:eth": "node scripts/refresh-eth.mjs",
    "refresh:equities": "node scripts/refresh-equities.mjs",
    "refresh:asset-comparison": "node scripts/refresh-asset-comparison.mjs",
    "build:research": "node scripts/build-research-sources.mjs && node scripts/build-treasury-research.mjs && node scripts/build-research-library.mjs",
    "verify:research": "node scripts/build-research-sources.mjs --check && node scripts/build-treasury-research.mjs --check && node scripts/build-research-library.mjs --check",
    "build:research-sources": "node scripts/build-research-sources.mjs",
    "verify:research-sources": "node scripts/build-research-sources.mjs --check",
    "build:eth-events": "node scripts/build-ethereum-events.mjs",
    "verify:eth-events": "node scripts/build-ethereum-events.mjs --check",
    "verify:cycle": "node scripts/refresh-cycle-calibration.mjs --check",
    "verify:performance": "node scripts/verify-chart-performance.mjs",
    "verify:formal": "node scripts/verify-market-state.mjs && node scripts/verify-equity-state.mjs && node scripts/verify-eth-state.mjs && node scripts/verify-publication-state.mjs && node verification/replay-state/verify.mjs build/replay-state.json",
    "build:standalone": "node scripts/build-standalone.mjs",
    "release:package": "node scripts/package-release.mjs",
    "build:forecast": "node scripts/build-forecast-ledger.mjs",
    "verify:forecast": "node scripts/build-forecast-ledger.mjs --check",
    "build:publication": "node scripts/build-publication.mjs",
    "verify:publication": "node scripts/build-publication.mjs --check",
    "verify:chart-replay": "node scripts/build-project-replay-baseline.mjs --check",
    "verify:chart-replay-state": "node verification/replay-state/verify.mjs build/replay-state.json",
    "build:domain": "node scripts/sync-market-domain.mjs",
    "verify:domain": "node scripts/sync-market-domain.mjs --check",
    "typecheck": "tsc --noEmit",
    "dev:web": "vite --config apps/web/vite.config.ts",
    "build:web": "npm run verify:domain && npm run verify:skullet && vite build --config apps/web/vite.config.ts",
    "start:api": "tsx apps/api/src/main.ts",
    "db:migrate": "tsx apps/jobs/src/market-lab.ts migrate",
    "db:import": "tsx apps/jobs/src/market-lab.ts import",
    "refresh:market-lab": "tsx apps/jobs/src/market-lab.ts refresh",
    "collect:us": "tsx apps/jobs/src/us-market.ts collect",
    "test:service": "npm run build:web && tsx --test tests/service/*.test.ts",
    "test:panels": "tsx --test tests/web/*.test.tsx",
    "verify:skullet": "node scripts/sync-skullet.mjs --check",
    "build:pages": "npm run verify:domain && npm run verify:skullet && node scripts/build-pages.mjs",
    "verify:pages": "npm run verify:domain && npm run verify:skullet && node scripts/build-pages.mjs --check",
    "verify:cloudflare": "node scripts/verify-cloudflare-build.mjs",
    "build:cloudflare": "node scripts/build-cloudflare.mjs",
    "build:cloudflare:models": "node scripts/build-cloudflare-model-component.mjs",
    "deploy:cloudflare:models": "node scripts/deploy-cloudflare-model-component.mjs",
    "deploy:cloudflare": "node scripts/deploy-cloudflare.mjs"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "devDependencies": {
    "@cloudflare/vite-plugin": "2.0.0-beta.v.12",
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "cf": "1.0.0-beta.28",
    "esbuild": "0.28.2",
    "linkedom": "0.18.15",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  },
  "overrides": {
    "glob": "14.0.2",
    "minimatch": "11.0.1"
  }
}

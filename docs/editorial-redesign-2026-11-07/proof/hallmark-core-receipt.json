) return Number(doc.querySelector('#equity-chart')?.dataset.observedCandleCount) > 0;\n            return doc.querySelectorAll('#lab-chart path').length > 0;\n          }, { timeout: 30000 }, atlasRoute);\n          console.error('HALLMARK_RENDER_READY ' + JSON.stringify({ url: file, route: atlasRoute }));\n        }",

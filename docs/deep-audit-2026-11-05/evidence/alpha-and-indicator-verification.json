  "exactPreviewBoundaryChange": {
    "beforeExpression": "const visiblePaint=paint.filter(item=>visible(item)&&item.background!=='rgba(0, 0, 0, 0)'&&item.background!=='transparent');",
    "afterExpression": "const visiblePaint=paint.filter(item=>visible(item)&&computedColorAlpha(item.background)>0);",
    "addedHelper": "function computedColorAlpha(color){\n  if(color==='transparent')return 0;\n  const rgb=color?.match(/^rgba?\\(\\s*[\\d.]+(?:\\s*,\\s*|\\s+)[\\d.]+(?:\\s*,\\s*|\\s+)[\\d.]+(?:\\s*(?:,|\\/)\\s*([\\d.]+))?\\s*\\)$/);\n  const alpha=rgb?Number(rgb[1]??1):NaN;\n  return Number.isFinite(alpha)&&alpha>=0&&alpha<=1?alpha:NaN;\n}",
    "note": "This exact assertion-boundary change addresses colored alpha-zero paint. Other independently documented harness changes include native clipping ownership and indicator policy; historical whole-file hashes are retained as measured."
  },

    :root {
      --focus: #9fc5ff;
      --border-strong: #63758d;
      --font-mono: ui-monospace, SFMono-Regular, Consolas, monospace;
      --font-mono-short: ui-monospace, SFMono-Regular, monospace;
      --font-mono-compact: ui-monospace, monospace;
      --font-mono-generic: monospace;
      --font-system: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
      --font-system-basic: system-ui, sans-serif;
      --control-radius: 4px;
      --panel-radius: 8px;
      --copy-size: 14px;
      --copy-leading: 1.75;
    }
    [data-theme="light"] { --focus: #2e5c8a; --border-strong: #667184; }
    html,body { overflow-x: clip; }
    :where(button,a,input,select,textarea,summary,[tabindex]):focus-visible,
    .chart-stage > svg:focus-visible {
      outline: 2px solid var(--focus) !important;
      outline-offset: -2px !important;
    }
    button:not(:disabled):not([aria-disabled="true"]):active,
    [role="button"]:not([aria-disabled="true"]):active {
      background-color: var(--surface-hover);
      box-shadow: inset 0 0 0 1px var(--border-strong);
    }
    button:disabled,[aria-disabled="true"] { cursor: not-allowed; }
    h1,h2,h3,h4,h5,h6 { min-width: 0; overflow-wrap: break-word; }
    dialog:is(.workspace-dialog,.chart-export-dialog,.forecast-journal,.eth-history-dialog,.symbol-search-dialog,.research-annotations-dialog,.asset-history-dialog,.daily-method-dialog,.eth-data-dialog,.equity-detail-dialog) {
      border-color: var(--border-strong);
      border-radius: var(--panel-radius);
    }
    
    /* Readable field boundaries and real control sizes across the trading workspace. */
    :root{--control-border:#8e9aac;--control-min-size:32px;--control-touch-size:44px;--prose-gutter:16px}
    [data-theme="light"]{--control-border:#667184}
    body #outlook-view select,
    body #chart-reader select,
    body #compare-view select,
    body #evidence-view input,
    body #evidence-view select,
    body #workbench-interval-select,
    body .eth-app select,
    body .eth-data-dialog select,
    body .equity-detail-dialog #equity-future-marker{
      border:1px solid var(--control-border);
    }
    body .eth-app .eth-topbar :is(button,select),
    body .eth-app .eth-bottom :is(button,select),
    body .eth-app .eth-tools button,
    body .lab-segmented button,
    body .lab-text-button,
    body #evidence-view .evidence-controls :is(input,select,button),
    body #evidence-view .evidence-title button.research-open,
    body #evidence-view .evidence-grade>button{
      min-height:var(--control-min-size);
    }
    body .eth-app .eth-topbar button,
    body .eth-app .eth-bottom button,
    body .eth-app .eth-tools button,
    body #evidence-view .evidence-grade>button{
      min-width:var(--control-min-size);
    }
    @media(max-width:620px),(pointer:coarse){
      body .eth-app{
        grid-template-rows:calc(48px + env(safe-area-inset-top,0px)) minmax(0,1fr) calc(48px + env(safe-area-inset-bottom,0px));
      }
      body .eth-app :is(.eth-topbar,.eth-bottom){
        flex-wrap:nowrap;overflow-x:auto;overflow-y:hidden;overscroll-behavior-x:contain;
        scrollbar-width:none;scroll-padding-inline:8px;touch-action:pan-x;
      }
      body .eth-app :is(.eth-topbar,.eth-bottom)::-webkit-scrollbar{display:none}
      body .eth-app .eth-topbar>:not(.eth-top-spacer){flex-shrink:0}
      body .eth-app .eth-topbar .eth-top-spacer{min-width:0}
      body .eth-app .eth-topbar :is(button,select),
      body .eth-app .eth-bottom :is(button,select),
      body .eth-app .eth-tools button{
        min-width:var(--control-touch-size);min-height:var(--control-touch-size);flex-shrink:0;
      }
      body .eth-app .eth-topbar .eth-icon{
        width:var(--control-touch-size);height:var(--control-touch-size);padding:12px;
      }
      body .lab-segmented button,
      body .lab-text-button,
      body #compare-view select,
      body #evidence-view .evidence-controls :is(input,select,button),
      body #evidence-view .evidence-title button.research-open,
      body #evidence-view .evidence-grade>button{min-height:var(--control-touch-size)}
      body .lab-segmented button,
      body #evidence-view .evidence-grade>button{min-width:var(--control-touch-size)}
    }
    @media(pointer:coarse) and (min-width:621px){
      body .eth-app{grid-template-columns:52px minmax(0,1fr)}
    }
    
    @media(max-width:620px){
      body #compare-view>.lab-inline-note{margin-inline:var(--prose-gutter)}
      body[data-page="outlook"] p:not(.lab-visually-hidden):not(svg p){margin-inline:var(--prose-gutter)}
    }
    body #evidence-view .evidence-title button.research-open>.evidence-title-text{
      min-width:0;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;
    }
    
    /* Prose and table footnotes retain a reading size separate from compact data labels. */
    body :is(#outlook-view,#compare-view,#chart-reader,#forecast-journal) p{
      font-size:max(12px,1em);line-height:1.6;
    }
    body :is(#outlook-view,#compare-view,#chart-reader,#forecast-journal) small{
      font-size:max(11px,.875em);
    }
    body #compare-view input{border:1px solid var(--control-border)}
    body #compare-view :is(button,select,input:not([type="range"])){min-height:var(--control-min-size)}
    @media(max-width:620px),(pointer:coarse){
      body #compare-view :is(button,select,input:not([type="range"])){min-height:var(--control-touch-size)}
    }
    
    body .footer button{min-height:var(--control-min-size)}
    @media(max-width:620px),(pointer:coarse){body .footer button{min-height:var(--control-touch-size)}}
    
    /* Shared scroll-edge header contract. Each selector names the real owner:
       dialogs, compact indicator stack, page table, RSI ledger or monthly ledger.
       These are independent scrollports, so none adds another owner's offset.
       Closed dialogs and hidden monthly panels do not acquire an anchor.
       Component CSS retains paint/layer order and horizontal identity pinning. */
    .indicator-library[open] > .indicator-library-heading,
    .symbol-search-dialog[open] > .symbol-search-heading,
    .atlas-plot[data-compact-layout] > .analysis-indicator-windows:not([hidden]):not([data-maximized=true]) > .analysis-pane-access:not([hidden]),
    #evidence-view:not([hidden]) .evidence-table thead,
    #ipo-view:not([hidden]) .ipo-table thead,
    #data-view:not([hidden]) .asset-comparison-table thead,
    .rsi-ledger-scroll:not([hidden]) > table > thead > tr > th,
    .housing-table-scroll > table.housing-table > thead > tr > th,
    .ml-scroll .housing-relation-layout > div > table.housing-table > thead > tr > th,
    .monthly-backtest:not([hidden]) .monthly-ledger > table > thead > tr > th {
      position: sticky;
      top: 0;
    }
    
    .research-detail-content .forecast-sources a{display:inline-block}
    .research-detail-content .forecast-sources cite{font-style:normal}
    
    /* An error owns a bounded row inside main, so existing details-grid and modal
       inert ownership stay intact. Legacy comparison retains document scrolling. */
    body:not([data-page=compare]) #main[data-btc-notice=true]{display:grid;grid-template-columns:minmax(0,1fr);grid-template-rows:auto minmax(0,1fr)}
    body:not([data-page=compare]) #main[data-btc-notice=true]>.btc-refresh-notice{grid-row:1}
    body:not([data-page=compare]) #main[data-btc-notice=true]>section{grid-row:2;min-width:0;min-height:0}
    .btc-refresh-notice{display:flex;align-items:center;gap:12px;min-width:0;padding:4px 8px;border-bottom:1px solid var(--border);background:var(--surface-raised);color:var(--text);font-size:12px;line-height:1.5}
    .btc-refresh-copy{display:flex;flex:1;align-items:baseline;flex-wrap:wrap;gap:0 12px;min-width:0}
    .btc-refresh-copy strong{font-weight:600;color:var(--accent)}
    .btc-refresh-copy span{color:var(--muted);font-variant-numeric:tabular-nums}
    .btc-refresh-notice button{flex:none;min-width:56px;min-height:36px;padding:4px 8px;border:1px solid var(--border);border-radius:4px;background:var(--surface);color:var(--text)}
    .btc-refresh-notice button:hover:not(:disabled){background:var(--surface-hover)}
    .btc-refresh-notice button:focus-visible{outline:2px solid var(--focus,var(--accent));outline-offset:2px}
    .btc-refresh-announcement{position:absolute;width:1px;height:1px;margin:-1px;padding:0;border:0;overflow:hidden;clip-path:inset(50%);white-space:nowrap}
    @media(max-width:620px){.btc-refresh-notice{gap:8px}.btc-refresh-copy{display:block;font-size:11px}.btc-refresh-copy strong,.btc-refresh-copy span{display:block}.btc-refresh-notice button{min-width:56px;min-height:44px}}
    
